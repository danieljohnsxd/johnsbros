{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "johnsbros",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "johnsbros.com", "custom_domain": true },
    { "pattern": "www.johnsbros.com", "custom_domain": true }
  ]
}
