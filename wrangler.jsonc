{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "johnsbros",
  "compatibility_date": "2026-10-05",
  // Runs before every `wrangler deploy`, including Cloudflare's Git builds.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "johnsbros.com", "custom_domain": true },
    { "pattern": "www.johnsbros.com", "custom_domain": true }
  ]
}
